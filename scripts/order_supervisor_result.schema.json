{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "order_supervisor_result.v1" },
    "work_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["completed", "blocked", "rejected", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 500 }
    },
    "error_code": { "type": ["string", "null"], "maxLength": 80 }
  },
  "required": ["schema", "work_id", "status", "summary", "evidence", "error_code"]
}
