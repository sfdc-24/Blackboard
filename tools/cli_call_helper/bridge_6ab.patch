+"""PR 441 plan items 6a and 6b (owner's direct approval 2026-10-30 21:56Z, source only): the said digest a consumer
+can check whole, and an owner "cancel" that reaches accepted work. Reuses test_call_bridge's fakes."""
+import datetime
+import hashlib
+import json
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import test_call_bridge as t                                             # noqa: E402
+from test_call_bridge import bridge, card, cb, open_window, row, turn
+
+CODEX = "chatgpt-codex-desktop"
+
+
+def state(conn, ask):
+    raw = conn.get(cb.STATE_KEY % ask)
+    return json.loads(raw) if raw else None
+
+
+class SaidDigest(unittest.TestCase):
+    def setUp(self):
+        self.conn = t.FakeRedis()
+        open_window(self.conn)
+
+    def test_the_digest_covers_exactly_the_words_the_inbox_carries(self):
+        said = "Codex, draft the lead | quote flow " + "with every stage " * 80      # over ASK_CHARS, with a pipe
+        turn(self.conn, said)
+        [ask] = bridge(self.conn).tick()
+        [(_, entry)] = self.conn.streams["fleet:inbox:%s" % CODEX]
+        words = said[:cb.ASK_CHARS].replace("|", "/")
+        self.assertIn(words, entry["text"])
+        digest = hashlib.sha256(words.encode("utf-8")).hexdigest()
+        self.assertEqual(digest, self.conn.get(cb.SAID_KEY % ask))
+        self.assertEqual((digest, str(len(words))), (entry["said_sha256"], entry["said_len"]))
+        n = state(self.conn, ask)["parts"]
+        parts = [json.loads(self.conn.get(cb.SAID_PART_KEY % (ask, i))) for i in range(n)]
+        self.assertEqual(words, "".join(parts), "the parts rebuild the whole ask")
+        self.assertEqual(digest, hashlib.sha256("".join(parts).encode("utf-8")).hexdigest())
+
+    def test_every_part_fits_the_200_character_governed_quote_even_with_escapes(self):
+        said = 'Codex, draft "the" plan \\ with quotes ' + '"' * 300
+        turn(self.conn, said)
+        [ask] = bridge(self.conn).tick()
+        for i in range(state(self.conn, ask)["parts"]):
+            self.assertLessEqual(len(self.conn.get(cb.SAID_PART_KEY % (ask, i))), 200)
+
+    def test_state_is_open_after_the_claim_and_done_after_the_answer(self):
+        turn(self.conn, "Codex, draft the queue flow.")
+        [ask] = bridge(self.conn).tick()
+        self.assertEqual(("open", CODEX, t.ROOM), (state(self.conn, ask)["state"], state(self.conn, ask)["agent"],
+                                                   state(self.conn, ask)["conference_room"]))
+        later = t.NOW + datetime.timedelta(minutes=3)
+        payload = "BCB|v=1|phase=RESULT|from=%s|answers=%s|text=ok" % (CODEX, ask)
+        self.assertEqual([ask], bridge(self.conn, clock=lambda: later).settle([row(CODEX, payload)]))
+        self.assertEqual("done", state(self.conn, ask)["state"])
+
+    def test_the_state_key_fits_a_governed_get_whole(self):
+        turn(self.conn, "Codex, draft the queue flow.")
+        [ask] = bridge(self.conn).tick()
+        self.assertLess(len(self.conn.get(cb.STATE_KEY % ask)), 200, "the reconciler quotes 200 characters")
+
+
+class CancelAcceptedWork(unittest.TestCase):
+    def setUp(self):
+        self.conn = t.FakeRedis()
+        open_window(self.conn)
+        turn(self.conn, "Codex, draft the queue flow.", seconds_ago=60)
+        [self.ask] = bridge(self.conn).tick()
+
+    def cancel(self, words, seconds_ago=5):
+        turn(self.conn, words, seconds_ago=seconds_ago)
+        return bridge(self.conn).tick()
+
+    def test_cancel_after_the_claim_cancels_that_ask_and_settle_can_no_longer_flip_it(self):
+        self.cancel("cancel that")
+        self.assertEqual("cancelled", state(self.conn, self.ask)["state"])
+        self.assertNotIn(self.ask, self.conn.hgetall(cb.OPEN_KEY))
+        got = card(self.conn, CODEX, self.ask)
+        self.assertEqual(("done", "cancelled in the room"), (got["status"], got["activity"]))
+        later = t.NOW + datetime.timedelta(minutes=3)
+        payload = "BCB|v=1|phase=RESULT|from=%s|answers=%s|text=ok" % (CODEX, self.ask)
+        self.assertEqual([], bridge(self.conn, clock=lambda: later).settle([row(CODEX, payload)]))
+        self.assertEqual("cancelled", state(self.conn, self.ask)["state"])
+
+    def test_the_agents_own_card_is_never_overwritten_by_the_cancel(self):
+        own = {"v": 1, "type": "note", "status": "working", "public": True, "version": 1, "ts": "x",
+               "title": "mine", "body": "b", "ask": self.ask}
+        self.conn.hset(t.cp.PARTITION % ("workshop", CODEX), self.ask, json.dumps(own))
+        self.cancel("cancel that")
+        self.assertEqual("mine", card(self.conn, CODEX, self.ask)["title"])
+        self.assertEqual("cancelled", state(self.conn, self.ask)["state"])
+
+    def test_a_cancel_in_another_conference_room_does_not_cancel_this_one(self):
+        fields = {"kind": "turn.started", "actor_id": "owner-1", "reason": "vocative", "room_id": "other-room",
+                  "control_sequence": "3", "utterance": "cancel that"}
+        self.conn.xadd("v1:conf:other-room:events", fields, entry_id=t.at(5))
+        bridge(self.conn).tick()
+        self.assertEqual("open", state(self.conn, self.ask)["state"])
+        self.cancel("cancel that")
+        self.assertEqual("cancelled", state(self.conn, self.ask)["state"], "the same words in its own room do")
+
+    def test_naming_another_agent_does_not_cancel_this_one(self):
+        self.cancel("Grok, cancel that")
+        self.assertEqual("open", state(self.conn, self.ask)["state"])
+
+    def test_an_ask_older_than_the_pending_window_is_not_cancelled(self):
+        old = t.NOW + datetime.timedelta(seconds=cb.PENDING_SECONDS + 120)
+        turn(self.conn, "cancel that", seconds_ago=-(cb.PENDING_SECONDS + 110))
+        bridge(self.conn, clock=lambda: old).tick()
+        self.assertEqual("open", state(self.conn, self.ask)["state"])
+
+    def test_a_task_containing_the_word_stop_is_not_a_cancel(self):
+        self.cancel("Codex, build a stop button")
+        self.assertEqual("open", state(self.conn, self.ask)["state"])
+
+
+if __name__ == "__main__":
+    unittest.main()
