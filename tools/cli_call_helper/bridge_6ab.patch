+    def cancel_latest(self, room, named, entry_id, now):
+        """His bounded "cancel" (cancellation()) in conference room `room`: his latest open ask there, claimed at most
+        PENDING_SECONDS before, for the agents he named if he named any, becomes cancelled. Removed from the open
+        record (settle can then never flip it to done), its state key says cancelled, and the bridge's own placeholder
+        card says so; an agent's own card is never overwritten (the agent withdraws it). Returns the ask or None."""
+        latest = None
+        for raw_ask in (self.conn.hgetall(OPEN_KEY) or {}):
+            ask = _text(raw_ask)
+            try:
+                state = json.loads(_text(self.conn.get(STATE_KEY % ask)) or "")
+                claimed_at = _parse(state["claimed_at"])
+            except (TypeError, ValueError, KeyError, AttributeError):
+                continue                                   # no state key (claimed before 6b): not cancellable here
+            if state.get("state") != "open" or state.get("conference_room") != room:
+                continue
+            if named and state.get("agent") not in named:
+                continue
+            if (now - claimed_at).total_seconds() > PENDING_SECONDS or claimed_at > now:
+                continue
+            if latest is None or claimed_at > latest[1]:
+                latest = (ask, claimed_at, state["agent"])
+        if latest is None:
+            return None
+        ask, claimed_at, agent = latest
+        partition = canvas_publish.PARTITION % (self.canvas_room, agent)
+        current = _text(self.conn.hget(partition, ask))
+        try:
+            mine = json.loads(current) if current else None
+        except ValueError:
+            mine = None
+        pipe = self.conn.pipeline(transaction=True)
+        try:
+            pipe.multi()
+            if isinstance(mine, dict) and mine.get("activity") in BRIDGE_ACTIVITIES and mine.get("status") == "claimed":
+                version = (mine.get("version") or 1) + 1
+                pipe.hset(partition, ask, json.dumps(cancelled_card(agent, claimed_at, now, version), sort_keys=True))
+            pipe.hdel(OPEN_KEY, ask)
+            pipe.set(STATE_KEY % ask, json.dumps({"state": "cancelled", "agent": agent, "at": stamp(now),
+                                                  "entry": entry_id}, sort_keys=True), ex=TTL_SECONDS)
+            pipe.execute()
+        finally:
+            pipe.reset()
+        self.log.info("call bridge: %s cancelled in the room for %s", ask, agent)
+        return ask
