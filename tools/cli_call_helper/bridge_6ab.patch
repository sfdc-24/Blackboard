+# Owner's direct approval 2026-10-30 21:56Z ("approve the two bridge changes, source only"; PR 441 plan items 6a, 6b).
+# 6a: the exact words the inbox carries, their sha256, and the words themselves in parts, all in keys no agent can
+#     write. A governed read quotes any value at 200 characters (redis_gov.PREVIEW_CHARS), so the inbox text is
+#     always cut for a governed reader; the parts (each a JSON string under 200 characters) let a consumer read the
+#     WHOLE ask from protected keys and check it against the digest. 6b: each ask's state, open | done | cancelled,
+#     in a small per-ask key a governed `get` reads whole; an owner "cancel" now also cancels his latest open ask.
+SAID_KEY = "gov:callbridge:said:%s"
+SAID_PART_KEY = "gov:callbridge:said:%s:%d"
+SAID_PART_CHARS = 90           # a JSON-quoted part stays under the 200-character quote, escapes included
+STATE_KEY = "gov:callbridge:state:%s"
+
+
+def said_text(said: str) -> str:
+    """The words exactly as inbox_text puts them in the inbox."""
+    return (said or "")[:ASK_CHARS].replace("|", "/")
+
+
+def said_digest(said: str) -> str:
+    return hashlib.sha256(said_text(said).encode("utf-8")).hexdigest()
+
+
+def said_parts(said: str) -> list:
+    text = said_text(said)
+    return [text[i:i + SAID_PART_CHARS] for i in range(0, len(text), SAID_PART_CHARS)] or [""]
+
+
+def cancelled_card(agent: str, claimed_at, now, version: int) -> dict:
+    """Public: who and when only, never a word of the owner's."""
+    name = NAME_OF[agent]
+    return {"v": 1, "type": "note", "status": "done", "public": True, "version": version, "ts": stamp(now),
+            "activity": "cancelled in the room",
+            "title": "Cancelled: %s's work from the room" % name,
+            "body": "Claimed in the room at %s, cancelled in the room at %s." % (eastern(claimed_at), eastern(now))}
 
 
