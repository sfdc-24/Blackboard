# Cross-platform evidence requires identical fixture bytes, including on Windows.
/tests/fixtures/order_supervisor_board.json text eol=lf

# Shell scripts are executed by a POSIX shell, and a CRLF checkout makes that
# shell fail with "bad interpreter: /bin/bash^M" - a confusing error that looks
# like a broken script rather than a broken checkout.
#
# This repo is developed on Windows and increasingly run on Linux, so the
# scripts most likely to be checked out with CRLF are exactly the ones that must
# not be. All 14 tracked .sh blobs are LF today, so this pins what is already
# true rather than renormalising anything.
*.sh text eol=lf

# The walkthrough fixtures are PARSED, not just read. zoom_bound_count.sh splits them
# with sed and awk, and a trailing CR turns `Source: 94` into `Source: 94\r`, so the
# numeric comparison silently stops matching. That is the same class as the CRLF
# shebang above but quieter: no error, just a check that answers zero forever.
/tools/walkthrough/fixtures/*.txt text eol=lf

# Python tolerates CRLF where bash does not, so this is a smaller hazard - but these
# files are shipped to a Linux box and read by tooling that may not be so forgiving,
# and git was already warning on measure_wav.py. Pin what is already true.
*.py text eol=lf

# Dialogue files are shipped to the presenter box and their text is SPOKEN.
# dialogue_parse.py collapses whitespace so a stray CR would not reach espeak-ng,
# but these files are also read aloud by a human rehearsing from them, and the
# JSON sits beside .sh and .py that are already pinned. Pin what is already true.
/tools/walkthrough/dialogue/*.json text eol=lf
