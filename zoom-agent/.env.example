# ── Zoom app credentials (Marketplace → your app → Basic Information) ──
# REQUIRED. Without these there is nothing to listen to.
ZOOM_CLIENT_ID=paste_your_client_id_here
ZOOM_CLIENT_SECRET=paste_your_client_secret_here

# ── WebSocket event subscription ──
# Marketplace → Features → Access → "RTMS media streams" → Endpoint URL → Copy.
# Paste the full wss:// URL. The app appends &access_token=... at runtime.
# NOTE: because events arrive over an OUTBOUND WebSocket, this agent needs NO
# public URL, no ngrok and no inbound firewall rule. Only OAuth uses localhost.
ZOOM_WS_ENDPOINT=wss://ws.zoom.us/ws?subscriptionId=paste_yours_here

# ── OAuth (must match Basic Information → OAuth Redirect URL exactly) ──
ZOOM_REDIRECT_URI=http://localhost:3000/oauth/callback
PORT=3000
# The callback binds LOOPBACK ONLY. This process holds a long-lived Zoom refresh
# token, so its authorization endpoint has no business being reachable from the
# network. Change this only if you know exactly why you are doing it.
OAUTH_HOST=127.0.0.1

# ── SFDC24 brain ──
# The same Apps Script reception() that www.sfdc24.com and the WhatsApp gateway
# call, so the Zoom agent shares one persona and one set of spend caps.
# Without it the agent still records the call but cannot answer anything.
SFDC24_EXEC=https://script.google.com/macros/s/paste_deployment_id/exec

# ── Delivery to the consultant's phone (optional; degrades to console) ──
# Same three values scripts/wa_notify.ps1 reads. The stored META_TOKEN in this
# project already begins with "Bearer " — notify.js strips it, do not add another.
META_TOKEN=paste_meta_system_user_token
WA_PHONE_NUMBER_ID=paste_phone_number_id
WA_TO=paste_recipient_msisdn
# Absolute ceiling on the Graph call. A hung send would otherwise hold the
# meeting's one-request lock open and silence the assistant for the rest of the
# call — which looks exactly like a quiet meeting.
NOTIFY_TIMEOUT_MS=15000

# ── Blackboard, for the post-call finding (optional) ──
BUS_URL=paste_bus_exec_url
BUS_SECRET=paste_bus_secret

# ── Behaviour ──
# Say one of these on the call and the agent answers. This is why it stays quiet.
WAKE_WORDS=sfdc24,hey consultant
# 0 = never volunteer anything. A positive N = consider speaking every N lines,
# and it may still decide there is nothing worth interrupting for. Start at 0.
ASSIST_EVERY_N=0
CONTEXT_LINES=30
SUMMARY_LINES=400
# reception() truncates a query at 1,000 characters, so a long call is
# summarised in bounded segments and each segment is a paid backend call. This
# caps how many. Whatever does not fit is COUNTED and stated on the summary and
# in the board finding — it is never silently dropped.
SUMMARY_MAX_CHUNKS=8
# POST-CALL WRAP-UP: OFF, and deliberately so.
# reception() has exactly one persona -- the website receptionist -- and it is
# instructed never to obey instructions embedded in a message and never to answer
# with a list. A call summary is both. The persona may decline and answer
# conversationally, and nothing on this side can tell that apart from a real
# summary, so a board finding could be a receptionist's reply wearing the word
# "summary". Held until the backend has a trusted summarisation route.
# Live wake-word assistance is unaffected and works with this off.
WRAP_UP_ENABLED=false
# Client conversations. Leave false unless you are debugging.
LOG_TRANSCRIPT=false
