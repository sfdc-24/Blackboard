# blackboard-bus configuration - loaded by systemd via EnvironmentFile.
# Fleet rule D-18: the secret lives HERE and in Script Properties-equivalents
# only. Never in source, never in a Drive doc, never in a board row.

# REQUIRED. The bus refuses to start without it. Generate one with:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-31
BUS_SECRET=

# Optional: during a rotation window the bus also accepts this value, so
# clients can be migrated one at a time. Remove it when rotation completes.
#BUS_PREVIOUS_SECRET=

# Bind address and port. Default binds loopback only: front the bus with a
# reverse proxy that terminates HTTPS (Caddy config in DEPLOY-GCP.md).
# Set BUS_BIND=0.0.0.0 ONLY if a GCP firewall rule scopes who can reach it.
BUS_BIND=127.0.0.1
BUS_PORT=8787
